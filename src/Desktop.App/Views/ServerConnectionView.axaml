<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
             x:Class="ResellerSystem.Desktop.App.Views.ServerConnectionView"
             x:DataType="vm:ServerConnectionViewModel">
    <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Server Connection" FontSize="22" FontWeight="Bold" />

        <TextBlock Text="Server Address" />
        <TextBox Text="{Binding ServerAddress}" Watermark="http://192.168.1.100:5000" />

        <Button Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnecting}" HorizontalAlignment="Left" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

        <StackPanel IsVisible="{Binding ConnectedServerVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Spacing="4">
            <TextBlock Text="{Binding ConnectedServerVersion, StringFormat='Server version: {0}'}" />
            <TextBlock Text="{Binding ConnectedStatus, StringFormat='Status: {0}'}" />
        </StackPanel>
    </StackPanel>
</UserControl>
