<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
        x:Class="ResellerSystem.Desktop.App.Views.SupplierEditDialog"
        x:DataType="vm:SupplierEditDialogViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Название" FontSize="11" />
            <TextBox Text="{Binding Name}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Телефон" FontSize="11" />
            <TextBox Text="{Binding Phone}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Email" FontSize="11" />
            <TextBox Text="{Binding Email}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Адрес" FontSize="11" />
            <TextBox Text="{Binding Address}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Заметки" FontSize="11" />
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" />
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaving}" />
        </StackPanel>
    </StackPanel>
</Window>
