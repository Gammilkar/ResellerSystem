<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
             xmlns:dto="using:ResellerSystem.Domain.Shared.Dto"
             x:Class="ResellerSystem.Desktop.App.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Inventory" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="New Purchase" Command="{Binding ToggleNewPurchaseFormCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="4" Content="Table Settings" Command="{Binding ToggleSettingsPanelCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Margin="0,0,0,8" />

        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,16"
                IsVisible="{Binding ShowNewPurchaseForm}">
            <StackPanel Spacing="6">
                <TextBlock Text="New Purchase" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Source" FontSize="11" />
                        <TextBox Text="{Binding NewSourceName}" Width="160" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Total Amount" FontSize="11" />
                        <TextBox Text="{Binding NewTotalAmount}" Width="100" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Item Name" FontSize="11" />
                        <TextBox Text="{Binding NewItemName}" Width="160" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Quantity" FontSize="11" />
                        <TextBox Text="{Binding NewQuantity}" Width="60" />
                    </StackPanel>
                    <Button Content="Add Purchase" Command="{Binding CreatePurchaseCommand}"
                            IsEnabled="{Binding !IsSavingPurchase}" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,16"
                IsVisible="{Binding ShowSettingsPanel}">
            <StackPanel Spacing="10">
                <TextBlock Text="Table Settings" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Text size" FontSize="11" />
                    <NumericUpDown Value="{Binding DataFontSize}" Minimum="9" Maximum="24" Increment="1" Width="120" />
                </StackPanel>
                <TextBlock Text="Высота строки подстраивается автоматически под текст (перенос по словам, как в Excel)."
                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" MaxWidth="400" />

                <TextBlock Text="Columns" FontSize="11" />
                <WrapPanel>
                    <CheckBox Content="№ товара" IsChecked="{Binding ShowItemNumberColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Наименование" IsChecked="{Binding ShowNameColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Статус" IsChecked="{Binding ShowStatusColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Дата покупки" IsChecked="{Binding ShowPurchaseDateColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Место покупки" IsChecked="{Binding ShowPurchaseSourceColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Тип закупки" IsChecked="{Binding ShowPurchaseTypeColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Итоговая себестоимость" IsChecked="{Binding ShowCostBasisColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Дата публикации" IsChecked="{Binding ShowListingDateColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Marketplace" IsChecked="{Binding ShowMarketplaceColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Дата продажи" IsChecked="{Binding ShowSaleDateColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Место продажи" IsChecked="{Binding ShowSaleMarketplaceColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Цена продажи" IsChecked="{Binding ShowSalePriceColumn}" Margin="0,0,16,4" />
                    <CheckBox Content="Дней в продаже" IsChecked="{Binding ShowDaysListedColumn}" Margin="0,0,16,4" />
                </WrapPanel>

                <Button Content="Done" Command="{Binding ToggleSettingsPanelCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding TableRows}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  FontSize="{Binding DataFontSize}">
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="FontSize" Value="{Binding HeaderFontSize}" />
                </Style>
                <!-- Shared look for every clickable cell (Наименование, the
                     3 dates, Место покупки) — a real Button, not a bare
                     TextBlock with a manual pointer handler: DataGridCell
                     reliably delivers clicks to standard interactive
                     controls placed in a CellTemplate (see the row-height
                     drag bug fixed in commit 48689d3, caused by exactly
                     the opposite approach). -->
                <Style Selector="Button.cell-link">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
                <Style Selector="Button.cell-link /template/ ContentPresenter">
                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="№ товара" Width="90" SortMemberPath="ItemNumber"
                                        IsVisible="{Binding ShowItemNumberColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <TextBlock Text="{Binding ItemNumber}" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Наименование" Width="220" SortMemberPath="Name"
                                        IsVisible="{Binding ShowNameColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <Button Classes="cell-link" Content="{Binding Name}"
                                    Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenItemCardCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Статус" Width="150" SortMemberPath="Status"
                                        IsVisible="{Binding ShowStatusColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <ComboBox ItemsSource="{x:Static vm:StatusOptions.All}"
                                      SelectedValueBinding="{Binding Code}"
                                      SelectedValue="{Binding Status, Mode=OneWay}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectionChanged="StatusCombo_SelectionChanged"
                                      HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата покупки" Width="110" SortMemberPath="PurchaseDate"
                                        IsVisible="{Binding ShowPurchaseDateColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <Button Classes="cell-link" Content="{Binding PurchaseDate}"
                                    Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenPurchaseDateCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Место покупки" Width="150" SortMemberPath="PurchaseSourceName"
                                        IsVisible="{Binding ShowPurchaseSourceColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <Button Classes="cell-link" Content="{Binding PurchaseSourceName}"
                                    Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenPurchaseSourceCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Тип закупки" Width="150" SortMemberPath="PurchaseType"
                                        IsVisible="{Binding ShowPurchaseTypeColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <ComboBox ItemsSource="{x:Static vm:PurchaseTypeOptions.All}"
                                      SelectedValueBinding="{Binding Code}"
                                      SelectedValue="{Binding PurchaseType, Mode=OneWay}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectionChanged="PurchaseTypeCombo_SelectionChanged"
                                      HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Итоговая себестоимость" Width="150" SortMemberPath="CostBasis"
                                        IsVisible="{Binding ShowCostBasisColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <TextBlock Text="{Binding CostBasis, StringFormat={}{0:C}}" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата публикации" Width="130" SortMemberPath="ListingPublishedDate"
                                        IsVisible="{Binding ShowListingDateColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <Button Classes="cell-link" Content="{Binding ListingPublishedDate, TargetNullValue='—'}"
                                    Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenListingDateCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Marketplace" Width="120" SortMemberPath="ListingMarketplace"
                                        IsVisible="{Binding ShowMarketplaceColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <AutoCompleteBox ItemsSource="{x:Static vm:MarketplaceOptions.Listing}"
                                      Text="{Binding ListingMarketplace, Mode=OneWay}"
                                      FilterMode="StartsWith"
                                      LostFocus="ListingMarketplaceCombo_LostFocus"
                                      HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата продажи" Width="110" SortMemberPath="SaleDate"
                                        IsVisible="{Binding ShowSaleDateColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <Button Classes="cell-link" Content="{Binding SaleDate, TargetNullValue='—'}"
                                    Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).OpenSaleDateCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Место продажи" Width="130" SortMemberPath="SaleMarketplace"
                                        IsVisible="{Binding ShowSaleMarketplaceColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <AutoCompleteBox ItemsSource="{x:Static vm:MarketplaceOptions.Sale}"
                                      Text="{Binding SaleMarketplace, Mode=OneWay}"
                                      FilterMode="StartsWith"
                                      LostFocus="SaleMarketplaceCombo_LostFocus"
                                      HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Цена продажи" Width="120" SortMemberPath="SalePrice"
                                        IsVisible="{Binding ShowSalePriceColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <TextBox Text="{Binding SalePrice, Mode=OneWay, StringFormat={}{0:0.00}}"
                                     LostFocus="SalePriceBox_LostFocus"
                                     Background="Transparent" BorderThickness="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дней в продаже" Width="120" SortMemberPath="DaysListed"
                                        IsVisible="{Binding ShowDaysListedColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:InventoryTableRowDto">
                            <TextBlock Text="{Binding DaysListed}" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
