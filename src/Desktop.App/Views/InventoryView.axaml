<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
             xmlns:dto="using:ResellerSystem.Domain.Shared.Dto"
             x:Class="ResellerSystem.Desktop.App.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Inventory" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="New Purchase" Command="{Binding ToggleNewPurchaseFormCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Margin="0,0,0,8" />

        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,16"
                IsVisible="{Binding ShowNewPurchaseForm}">
            <StackPanel Spacing="6">
                <TextBlock Text="New Purchase" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Source" FontSize="11" />
                        <TextBox Text="{Binding NewSourceName}" Width="160" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Total Amount" FontSize="11" />
                        <TextBox Text="{Binding NewTotalAmount}" Width="100" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Item Name" FontSize="11" />
                        <TextBox Text="{Binding NewItemName}" Width="160" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Quantity" FontSize="11" />
                        <TextBox Text="{Binding NewQuantity}" Width="60" />
                    </StackPanel>
                    <Button Content="Add Purchase" Command="{Binding CreatePurchaseCommand}"
                            IsEnabled="{Binding !IsSavingPurchase}" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding TableRows}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Дата покупки" Binding="{Binding PurchaseDate}" Width="110" />
                <DataGridTextColumn Header="Место покупки" Binding="{Binding PurchaseSourceName}" Width="150" />
                <DataGridTextColumn Header="Тип закупки" Binding="{Binding PurchaseType}" Width="120" />
                <DataGridTextColumn Header="Итоговая себестоимость" Binding="{Binding CostBasis, StringFormat={}{0:C}}" Width="150" />
                <DataGridTextColumn Header="Дата публикации" Binding="{Binding ListingPublishedDate}" Width="130" />
                <DataGridTextColumn Header="Marketplace" Binding="{Binding ListingMarketplace}" Width="120" />
                <DataGridTextColumn Header="Дата продажи" Binding="{Binding SaleDate}" Width="110" />
                <DataGridTextColumn Header="Место продажи" Binding="{Binding SaleMarketplace}" Width="130" />
                <DataGridTextColumn Header="Цена продажи" Binding="{Binding SalePrice, StringFormat={}{0:C}}" Width="120" />
                <DataGridTextColumn Header="Дней в продаже" Binding="{Binding DaysListed}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
