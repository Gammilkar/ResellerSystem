<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
        x:Class="ResellerSystem.Desktop.App.Views.DatePickerDialog"
        x:DataType="vm:DatePickerDialogViewModel"
        Title="{Binding Title}"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
        <CalendarDatePicker SelectedDate="{Binding SelectedDate}" HorizontalAlignment="Stretch" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" />
            <Button Content="OK" Command="{Binding OkCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
