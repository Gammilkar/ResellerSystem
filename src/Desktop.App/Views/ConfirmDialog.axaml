<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
        x:Class="ResellerSystem.Desktop.App.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
