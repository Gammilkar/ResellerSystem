<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResellerSystem.Desktop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Real Excel-like grid (drag-to-resize/reorder columns) — Product
         Specification section 35, needed for the Inventory table. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <!-- Used transitively via Desktop.Services' TrustedDeviceStore (DPAPI).
         Needs a direct reference here too — the SDK only writes a runtime
         package into the *publishing* project's deps.json when that
         project references it directly; without this, self-contained
         publish copies the DLL to the output folder but the app can't
         load it at runtime (FileNotFoundException, not caught by any
         build-time check). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Desktop.ViewModels\Desktop.ViewModels.csproj" />
    <ProjectReference Include="..\Desktop.Services\Desktop.Services.csproj" />
  </ItemGroup>
</Project>
