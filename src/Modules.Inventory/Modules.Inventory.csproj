<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResellerSystem.Modules.Inventory</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Modules ARE allowed to reference Server.Data/Server.Application —
         the architectural rule (Product Development Plan v1.0, Part 2.1)
         is that Server.Api/Server.Host never reference concrete MODULES,
         not that modules can't use Core's persistence building blocks
         (ConnectionStringFactory, IDatabaseContextResolver, IMigrationRunner
         contract types). Reimplementing those per-module would be the
         over-engineering the brief explicitly warned against. -->
    <ProjectReference Include="..\Server.Modules.Abstractions\Server.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\Server.Application\Server.Application.csproj" />
    <ProjectReference Include="..\Server.Data\Server.Data.csproj" />
    <ProjectReference Include="..\Domain.Shared\Domain.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\Scripts\**\*.sql" />
  </ItemGroup>
</Project>
