<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResellerSystem.Desktop.ViewModels"
             x:Class="ResellerSystem.Desktop.App.Views.SelectedDatabaseView"
             x:DataType="vm:SelectedDatabaseViewModel">
    <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding DatabaseName}" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="Database connected successfully." />

        <TextBlock Text="{Binding ServerVersion, StringFormat='Server: {0}'}" />
        <TextBlock Text="{Binding TenantSchemaVersion, StringFormat='Schema: {0}'}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Button Content="Change Database" Command="{Binding ChangeDatabaseCommand}" HorizontalAlignment="Left" />
        <Button Content="Open Inventory" Command="{Binding OpenInventoryCommand}" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
